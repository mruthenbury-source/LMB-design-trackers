{
  "routes": [
    { "route": "/login", "redirect": "/.auth/login/aad" },
    { "route": "/logout", "redirect": "/.auth/logout" },

    { "route": "/api/health", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/meta", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/bootstrap", "allowedRoles": ["anonymous", "authenticated"] },

    { "route": "/api/state", "allowedRoles": ["anonymous", "authenticated"] },

    { "route": "/api/chat", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/exportPdf", "allowedRoles": ["anonymous", "authenticated"] },

    { "route": "/api/save", "allowedRoles": ["authenticated"] },
    { "route": "/api/tick", "allowedRoles": ["authenticated"] },
    { "route": "/api/backupWeekly", "allowedRoles": ["authenticated"] },

    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*"]
  },
  "responseOverrides": {
    "401": { "redirect": "/login" }
  }
}
