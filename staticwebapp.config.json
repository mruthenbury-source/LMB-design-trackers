{
  "routes": [
    {
      "route": "/login",
      "redirect": "/.auth/login/aad"
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout"
    },
    {
      "route": "/api/state",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/unlock",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/api/tick",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/comment",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/backupWeekly",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/chat",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "responseOverrides": {
    "401": {
      "redirect": "/login"
    }
  }
}
